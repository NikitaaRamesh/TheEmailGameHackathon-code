# Optional. The README sets these as shell variables, which is all you need. If
# you would rather keep them in a file, copy this to .env and fill it in - .env
# is gitignored, so never commit it.

# Your issued key and gateway URL, both from your handout. These are the only
# credentials that work in the competition.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://gateway.theemailgame.com

# Optional: default model for the agents you launch (--model overrides it).
# Only gpt-4.1 and gpt-4.1-mini pass the gateway.
# OPENAI_MODEL=gpt-4.1

# Verify your setup with:  python scripts/check_openai_key.py
